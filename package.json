{
  "name": "visual-project-workflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A clonable, local-first planning system. This repo becomes a consumer's .planning/ directory (#1, #20, #32, #69).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "lint:plan": "node bin/lint-plan.mjs",
    "dev": "node app/server.mjs",
    "research:probe": "node bin/research-probe.mjs",
    "research:search": "node bin/research.mjs search",
    "research:record": "node bin/research.mjs record",
    "handoff": "node bin/handoff.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chokidar": "^5.0.0"
  }
}
