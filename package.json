{
  "name": "visual-project-workflow",
  "version": "26.9.0",
  "private": true,
  "type": "module",
  "description": "A clonable, local-first planning system. This repo becomes a consumer's .planning/ directory (#1, #20, #32, #69).",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node bin/run-test-suite.mjs",
    "test:ci:core": "node bin/run-test-group.mjs core",
    "test:ci:node": "node bin/run-test-group.mjs node",
    "test:ci:platform": "node bin/run-test-group.mjs platform",
    "test:ci:setup": "node bin/run-test-group.mjs setup",
    "test:ci:consumer": "node bin/run-test-group.mjs consumer",
    "test:pi-compat": "node --test test/pi-compat.test.mjs",
    "init:project": "node bin/init-project.mjs",
    "lint:plan": "node bin/lint-plan.mjs",
    "lint:shell": "node bin/lint-shell.mjs",
    "skills:generate": "node bin/generate-stage-skills.mjs",
    "skills:check": "node bin/generate-stage-skills.mjs --check",
    "authoring-schemas:generate": "node bin/generate-artifact-authoring-schemas.mjs",
    "authoring-schemas:check": "node bin/generate-artifact-authoring-schemas.mjs --check",
    "roles:generate": "node bin/generate-specialist-roles.mjs",
    "roles:check": "node bin/generate-specialist-roles.mjs --check",
    "audit:production": "node bin/audit-production.mjs",
    "postinstall": "node bin/repair-pi-brace-expansion.mjs",
    "dev": "node app/server.mjs",
    "shell:build": "next build",
    "shell:start": "next start --hostname 127.0.0.1",
    "research:probe": "node bin/research-probe.mjs",
    "research:search": "node bin/research.mjs search",
    "research:record": "node bin/research.mjs record",
    "decisioning:configure": "node bin/decisioning.mjs configure",
    "decisioning:probe": "node bin/decisioning.mjs probe",
    "decisioning:route": "node bin/decisioning.mjs route",
    "decisioning:compare": "node bin/decisioning.mjs compare",
    "decisioning:trace": "node bin/decisioning.mjs trace",
    "decisioning:evidence": "node bin/decisioning.mjs evidence",
    "decisioning:review": "node bin/decisioning.mjs review",
    "decisioning:proposal": "node bin/decisioning.mjs proposal",
    "decisioning:intake": "node bin/decisioning.mjs intake",
    "decisioning:specialist": "node bin/decisioning.mjs specialist",
    "handoff": "node bin/handoff.mjs",
    "migrate:content": "node bin/migrate-content.mjs",
    "start": "node bin/start-shell.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@mdx-js/mdx": "3.1.1",
    "@seriousme/openapi-schema-validator": "2.9.1",
    "@typesafe-ai/sdk": "0.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "brace-expansion": "5.0.12",
    "chokidar": "^5.0.0",
    "next": "16.3.7",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "unist-util-visit": "5.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "brace-expansion": "$brace-expansion"
  }
}
